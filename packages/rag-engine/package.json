{
  "name": "@motorcycle-ai/rag-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "feasibility": "npm run build && node --enable-source-maps dist/feasibility/demo.js",
    "demo:diagnose": "npm run build && node --enable-source-maps dist/demo/diagnose-demo.js",
    "demo:interactive": "npm run build && node --enable-source-maps dist/demo/interactive-diagnose.js",
    "test": "npm run build && node --test dist/*.test.js"
  },
  "dependencies": {
    "@motorcycle-ai/shared": "0.1.0"
  }
}
